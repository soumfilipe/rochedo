{
  "name": "rochedo",
  "version": "0.1.0",
  "description": "Rochedo: design system de Filipe Costa (variáveis, fontes, ícones e componentes em CSS puro).",
  "type": "module",
  "files": ["dist", "src"],
  "exports": {
    ".": "./dist/rochedo.css",
